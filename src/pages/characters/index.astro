---
import Base from '../../layouts/Base.astro';
import Portrait from '../../components/Portrait.astro';
import data from '../../data/characters.json';

const base = import.meta.env.BASE_URL;
const characters = data.characters;
const sideLabel: Record<string, string> = Object.fromEntries(data.sides.map((s) => [s.key, s.label]));
const groupOf = (g: string) => characters.filter((c) => c.group === g);
---

<Base title="人物ファイル" description="キラ事件に関わった人物の一覧。陣営別に収録し、公式プロフィールと作中での動きをまとめています。">
  <h1>🗂 人物ファイル <small class="muted">事件関係者名簿</small></h1>
  <p class="muted">
    捜査本部・SPK・死神まで、キラ事件に関わった人物をまとめています。カードをタップすると詳細を閲覧できます。
    生年月日や身長などのプロフィールは公式資料に基づきます。
  </p>

  <div class="toolbar card">
    <input id="q" type="search" placeholder="名前・かなで検索" />
    <div class="chips">
      <button class="filter-chip active" data-filter="">全員</button>
      {data.groups.map((g) => (
        <button class="filter-chip" data-filter={`group-${g.key}`}>{g.label}</button>
      ))}
    </div>
  </div>

  <div id="roster" data-sp-count>
    <p class="sp-note"></p>
    {data.groups.map((g) => (
      <section class="roster-section" data-section={`group-${g.key}`}>
        <h2 class="section-title">{g.label}</h2>
        <div class="grid cards">
          {groupOf(g.key).map((c) => (
            <a
              href={`${base}characters/${c.id}/`}
              class="char-card card"
              data-sp={c.sp > 1 ? c.sp : undefined}
              data-sp-hide={c.sp > 1 ? '' : undefined}
              data-name={`${c.name} ${c.kana}`}
            >
              <Portrait id={c.portrait ? c.id : `sil-${c.id}`} size={72} sideKey={c.side} />
              <div class="char-meta">
                <strong>{c.name}</strong>
                <small class="muted">{c.kana}</small>
                <span class="side-chip" data-side={c.side}>{sideLabel[c.side]}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const cards = [...document.querySelectorAll<HTMLElement>('.char-card')];
    const sections = [...document.querySelectorAll<HTMLElement>('.roster-section')];
    let filter = '';

    const applyFilter = () => {
      const term = q.value.trim().toLowerCase();
      sections.forEach((sec) => {
        const visible = filter === '' || sec.dataset.section === filter;
        sec.style.display = visible ? '' : 'none';
      });
      cards.forEach((c) => {
        const hit = term === '' || (c.dataset.name ?? '').toLowerCase().includes(term);
        c.style.setProperty('display', hit ? '' : 'none');
      });
    };
    q.addEventListener('input', applyFilter);
    document.querySelectorAll<HTMLElement>('.filter-chip').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        filter = b.dataset.filter ?? '';
        applyFilter();
      });
    });
  </script>

  <style>
    .toolbar { padding: 14px; display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
    .toolbar input {
      padding: 9px 12px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--bg); color: var(--ink); font-size: 0.95rem;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .filter-chip {
      border: 1px solid var(--line); background: var(--surface-2); color: var(--ink);
      border-radius: 999px; padding: 4px 12px; font-size: 0.82rem; cursor: pointer;
    }
    .filter-chip.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
    .cards { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    .char-card {
      display: flex; gap: 12px; align-items: center; padding: 12px;
      text-decoration: none; transition: transform 0.1s ease;
    }
    .char-card:hover { transform: translateY(-2px); border-color: var(--accent); }
    .char-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; line-height: 1.4; min-width: 0; }
    .char-meta strong { font-size: 1rem; }
  </style>
</Base>
