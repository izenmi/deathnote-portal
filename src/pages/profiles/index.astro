---
import Base from '../../layouts/Base.astro';
import Portrait from '../../components/Portrait.astro';
import data from '../../data/characters.json';
import timeline from '../../data/timeline.json';

const base = import.meta.env.BASE_URL;
const sideLabel: Record<string, string> = Object.fromEntries(data.sides.map((s) => [s.key, s.label]));
const spLabel = (sp: number) => timeline.volumes.find((v) => v.ord === sp)?.label ?? '';

const fmtDate = (d: string | null) => {
  if (!d) return '—';
  const [y, m, day] = d.split('-');
  return `${y}.${m}.${day}`;
};

const rows = (data.characters as any[]).map((c) => {
  const p = c.profile ?? {};
  return {
    c,
    born: p.born ?? null,
    height: p.height ?? null,
    weight: p.weight ?? null,
    blood: p.blood ?? null,
  };
});

const SORTS = [
  { key: 'kana', label: 'あいうえお順' },
  { key: 'born', label: '生年月日が早い順' },
  { key: 'height', label: '身長が高い順' },
  { key: 'weight', label: '体重が重い順' },
  { key: 'sp', label: '登場が早い順' },
];
---

<Base title="プロフィール一覧" description="キラ事件の関係者の公式プロフィールを一覧表で。生年月日・身長・体重で並べ替えできます。">
  <h1>📇 プロフィール一覧</h1>
  <p class="muted">
    人物ファイルに収録している全員の公式プロフィールを一覧にしたものです。見出しのボタンで並べ替えられます。
    読了位置(右上📖)より先に登場する人物は伏せています。
  </p>

  <div class="card panel">
    <div class="chips" id="sort-chips">
      {SORTS.map((s, i) => (
        <button class={`filter-chip${i === 0 ? ' active' : ''}`} data-sort={s.key}>{s.label}</button>
      ))}
    </div>
  </div>

  <div class="card table-card" data-sp-count>
    <p class="sp-note"></p>
    <table class="prof-table">
      <thead>
        <tr>
          <th class="col-name">人物</th>
          <th>陣営</th>
          <th>生年月日</th>
          <th>身長</th>
          <th>体重</th>
          <th>血液型</th>
          <th>初登場</th>
        </tr>
      </thead>
      <tbody id="prof-body">
        {rows.map((r) => (
          <tr
            data-sp={r.c.sp > 1 ? r.c.sp : undefined}
            data-sp-hide={r.c.sp > 1 ? '' : undefined}
            data-kana={r.c.kana}
            data-born={r.born ?? ''}
            data-height={r.height ?? ''}
            data-weight={r.weight ?? ''}
            data-sp-ord={r.c.sp}
          >
            <td class="col-name">
              <a href={`${base}characters/${r.c.id}/`} class="name-cell">
                <Portrait id={r.c.portrait ? r.c.id : `sil-${r.c.id}`} size={34} sideKey={r.c.side} />
                <span>{r.c.name}</span>
              </a>
            </td>
            <td><span class="side-chip" data-side={r.c.side}>{sideLabel[r.c.side]}</span></td>
            <td class="num">{fmtDate(r.born)}</td>
            <td class="num">{r.height ? `${r.height}cm` : '—'}</td>
            <td class="num">{r.weight ? `${r.weight}kg` : '—'}</td>
            <td class="num">{r.blood ? `${r.blood}型` : '—'}</td>
            <td class="num small">{spLabel(r.c.sp)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="muted small-note">
    ※ 死神には人間のような身長・体重・血液型のプロフィールは設定されていないため「—」と表示しています。
  </p>

  <script>
    const body = document.getElementById('prof-body') as HTMLElement;
    const rows = [...body.querySelectorAll<HTMLTableRowElement>('tr')];

    const sortBy = (key: string) => {
      const sorted = [...rows].sort((a, b) => {
        const av = a.dataset, bv = b.dataset;
        if (key === 'kana') return (av.kana ?? '').localeCompare(bv.kana ?? '', 'ja');
        if (key === 'sp') return Number(av.spOrd) - Number(bv.spOrd);
        if (key === 'born') {
          // 値なしは末尾へ
          if (!av.born) return 1;
          if (!bv.born) return -1;
          return av.born.localeCompare(bv.born);
        }
        const an = Number(av[key as 'height' | 'weight']);
        const bn = Number(bv[key as 'height' | 'weight']);
        if (!an) return 1;
        if (!bn) return -1;
        return bn - an;
      });
      sorted.forEach((r) => body.appendChild(r));
    };

    document.querySelectorAll<HTMLElement>('#sort-chips .filter-chip').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('#sort-chips .filter-chip').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        sortBy(b.dataset.sort ?? 'kana');
      });
    });
    sortBy('kana');
  </script>

  <style>
    .panel { padding: 14px; margin-top: 14px; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .filter-chip {
      border: 1px solid var(--line); background: var(--surface-2); color: var(--ink);
      border-radius: 999px; padding: 4px 12px; font-size: 0.82rem; cursor: pointer;
    }
    .filter-chip.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
    .table-card { padding: 14px; margin-top: 14px; overflow-x: auto; }
    .prof-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 680px; }
    .prof-table th {
      text-align: left; font-size: 0.76rem; color: var(--ink-2);
      border-bottom: 2px solid var(--line); padding: 8px 10px; white-space: nowrap;
    }
    .prof-table td { border-bottom: 1px solid var(--line); padding: 7px 10px; }
    .prof-table tr:last-child td { border-bottom: none; }
    .col-name { min-width: 160px; }
    .name-cell {
      display: flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600;
    }
    .name-cell:hover { color: var(--accent); }
    .num { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .small { font-size: 0.78rem; color: var(--ink-2); }
    .small-note { font-size: 0.78rem; }
  </style>
</Base>
