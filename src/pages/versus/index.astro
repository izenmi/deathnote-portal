---
import Base from '../../layouts/Base.astro';
import data from '../../data/characters.json';
import cases from '../../data/cases.json';
import rel from '../../data/relations.json';
import timeline from '../../data/timeline.json';

const base = import.meta.env.BASE_URL;
const sideLabel: Record<string, string> = Object.fromEntries(data.sides.map((s) => [s.key, s.label]));

// クライアントへ渡す比較用データ
const vsData = Object.fromEntries(
  (data.characters as any[]).map((c) => [
    c.id,
    {
      name: c.name,
      kana: c.kana,
      side: c.side,
      sideLabel: sideLabel[c.side],
      sp: c.sp,
      kind: c.kind,
      bio: c.bio,
      profile: c.profile ?? {},
      status: c.status ?? null,
    },
  ])
);
const caseIndex = cases.map((c) => ({ id: c.id, name: c.name, vol: c.vol, sp: c.sp, chars: c.chars }));
const edges = rel.edges.map((e) => ({ a: e.a, b: e.b, label: e.label, type: e.type, sp: e.sp, endSp: (e as any).endSp ?? null }));
const typeLabels = Object.fromEntries(Object.entries(rel.types).map(([k, v]: [string, any]) => [k, v.label]));
const volLabels = Object.fromEntries(timeline.volumes.map((v) => [v.ord, v.label]));
const options = (data.characters as any[]).map((c) => ({ id: c.id, name: c.name, sp: c.sp }));
---

<Base title="VS比較" description="2人のプロフィールと、関わった事件・二人の関係を並べて比較します。">
  <h1>⚔️ VS比較</h1>
  <p class="muted">
    2人を選ぶと、公式プロフィール・共通して関わった事件・二人の関係を並べて表示します。
    読了位置(右上📖)より先に登場する人物は選べません。URLをそのまま共有できます。
  </p>

  <div class="card panel">
    <div class="vs-selects">
      <label>
        <span class="muted">人物A</span>
        <select id="sel-a">
          {options.map((o) => <option value={o.id} data-sp={o.sp}>{o.name}</option>)}
        </select>
      </label>
      <span class="vs-mark">VS</span>
      <label>
        <span class="muted">人物B</span>
        <select id="sel-b">
          {options.map((o) => <option value={o.id} data-sp={o.sp}>{o.name}</option>)}
        </select>
      </label>
    </div>
    <div class="vs-actions">
      <button id="btn-copy" class="share-btn" type="button">🔗 このURLをコピー</button>
      <span id="copy-note" class="muted"></span>
    </div>
  </div>

  <div id="vs-result"></div>

  <script is:inline define:vars={{ vsData, caseIndex, edges, typeLabels, volLabels, base }}>
    const selA = document.getElementById('sel-a');
    const selB = document.getElementById('sel-b');
    const out = document.getElementById('vs-result');

    const params = new URLSearchParams(location.search);
    selA.value = vsData[params.get('a')] ? params.get('a') : 'light';
    selB.value = vsData[params.get('b')] ? params.get('b') : 'l';

    const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]);
    const fmtDate = (d) => {
      if (!d) return '—';
      const [y, m, day] = d.split('-');
      return `${y}年${Number(m)}月${Number(day)}日`;
    };

    // 未登場の人物は選べないようにする
    const gate = () => {
      const p = window.KIRA ? window.KIRA.progress : 0;
      [selA, selB].forEach((sel) => {
        [...sel.options].forEach((o) => {
          const locked = Number(o.dataset.sp) > Math.max(p, 1);
          o.disabled = locked;
          o.textContent = locked ? '🔒 ???' : vsData[o.value].name;
        });
        if (sel.selectedOptions[0] && sel.selectedOptions[0].disabled) {
          const first = [...sel.options].find((o) => !o.disabled);
          if (first) sel.value = first.value;
        }
      });
    };

    const render = () => {
      const p = window.KIRA ? window.KIRA.progress : 0;
      const a = vsData[selA.value], b = vsData[selB.value];
      if (!a || !b) return;

      const row = (label, va, vb) =>
        `<tr><td class="v">${esc(va)}</td><th>${esc(label)}</th><td class="v">${esc(vb)}</td></tr>`;

      const statusOf = (c) => (c.status && c.status.sp <= p ? c.status.text : '—');

      // 共通して関わった事件(読了位置まで)
      const shared = caseIndex.filter(
        (c) => c.sp <= p && c.chars.includes(selA.value) && c.chars.includes(selB.value)
      );

      // 二人の直接の関係(読了位置で有効なもの)
      const rels = edges.filter(
        (e) =>
          ((e.a === selA.value && e.b === selB.value) || (e.b === selA.value && e.a === selB.value)) &&
          e.sp <= p && (e.endSp === null || p < e.endSp)
      );
      const pastRels = edges.filter(
        (e) =>
          ((e.a === selA.value && e.b === selB.value) || (e.b === selA.value && e.a === selB.value)) &&
          e.endSp !== null && e.endSp <= p
      );

      out.innerHTML = `
        <div class="card vs-card">
          <div class="vs-head">
            <div class="vs-side">
              <a href="${base}characters/${selA.value}/"><strong>${esc(a.name)}</strong></a>
              <span class="side-chip" data-side="${a.side}">${esc(a.sideLabel)}</span>
            </div>
            <span class="vs-mark">VS</span>
            <div class="vs-side">
              <a href="${base}characters/${selB.value}/"><strong>${esc(b.name)}</strong></a>
              <span class="side-chip" data-side="${b.side}">${esc(b.sideLabel)}</span>
            </div>
          </div>
          <table class="vs-table">
            <tbody>
              ${row('よみ', a.kana, b.kana)}
              ${row('生年月日', fmtDate(a.profile.born), fmtDate(b.profile.born))}
              ${row('身長', a.profile.height ? a.profile.height + 'cm' : '—', b.profile.height ? b.profile.height + 'cm' : '—')}
              ${row('体重', a.profile.weight ? a.profile.weight + 'kg' : '—', b.profile.weight ? b.profile.weight + 'kg' : '—')}
              ${row('血液型', a.profile.blood ? a.profile.blood + '型' : '—', b.profile.blood ? b.profile.blood + '型' : '—')}
              ${row('初登場', volLabels[a.sp] ?? '—', volLabels[b.sp] ?? '—')}
              ${row('その後', statusOf(a), statusOf(b))}
            </tbody>
          </table>
        </div>

        <section>
          <h2 class="section-title">二人の関係</h2>
          ${
            rels.length || pastRels.length
              ? `<ul class="rel-list">
                  ${rels.map((e) => `<li class="card rel-item"><span class="rel-type">${esc(typeLabels[e.type] ?? e.type)}</span>${esc(e.label)}<span class="muted rel-when">（${esc(volLabels[e.sp] ?? '')}〜）</span></li>`).join('')}
                  ${pastRels.map((e) => `<li class="card rel-item past"><span class="rel-type">${esc(typeLabels[e.type] ?? e.type)}</span>${esc(e.label)}<span class="muted rel-when">（${esc(volLabels[e.sp] ?? '')}〜${esc(volLabels[e.endSp] ?? '')}）</span></li>`).join('')}
                </ul>`
              : '<p class="muted">読了位置の時点では、この二人に直接の関係は記録されていません。</p>'
          }
        </section>

        <section>
          <h2 class="section-title">共通して関わった事件</h2>
          ${
            shared.length
              ? `<ul class="case-list">${shared
                  .map((c) => `<li><a href="${base}cases/${c.id}/" class="card case-link"><span class="muted">${esc(c.vol)}巻</span> ${esc(c.name)}</a></li>`)
                  .join('')}</ul>`
              : '<p class="muted">読了位置の時点で、二人がともに関わった事件はありません。</p>'
          }
        </section>
      `;

      const q = new URLSearchParams({ a: selA.value, b: selB.value });
      history.replaceState(null, '', `${location.pathname}?${q}`);
    };

    const update = () => { gate(); render(); };
    selA.addEventListener('change', update);
    selB.addEventListener('change', update);
    document.addEventListener('kira:progress', update);
    window.addEventListener('DOMContentLoaded', update);

    document.getElementById('btn-copy').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        document.getElementById('copy-note').textContent = 'コピーしました';
        setTimeout(() => { document.getElementById('copy-note').textContent = ''; }, 2000);
      } catch {
        document.getElementById('copy-note').textContent = 'コピーできませんでした';
      }
    });
  </script>

  <style>
    .panel { padding: 16px; margin-top: 14px; }
    .vs-selects { display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap; }
    .vs-selects label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8rem; flex: 1 1 200px; }
    .vs-selects select {
      padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--bg); color: var(--ink); font-size: 0.95rem;
    }
    .vs-mark { font-weight: 800; color: var(--accent); padding-bottom: 8px; }
    .vs-actions { display: flex; align-items: center; gap: 10px; margin-top: 12px; font-size: 0.8rem; }
    .share-btn {
      border: 1px solid var(--line); background: var(--surface-2); color: var(--ink);
      border-radius: 8px; padding: 6px 12px; font-size: 0.82rem; cursor: pointer;
    }
    .share-btn:hover { border-color: var(--accent); }
  </style>

  <style is:global>
    .vs-card { padding: 18px; margin-top: 14px; }
    .vs-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .vs-side { display: flex; flex-direction: column; gap: 4px; align-items: center; flex: 1; }
    .vs-side a { text-decoration: none; font-size: 1.1rem; }
    .vs-side a:hover { color: var(--accent); }
    .vs-table { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 0.9rem; }
    .vs-table th {
      text-align: center; font-size: 0.76rem; color: var(--ink-2); font-weight: 700;
      background: var(--surface-2); padding: 7px 8px; white-space: nowrap;
    }
    .vs-table td.v { text-align: center; padding: 7px 10px; }
    .vs-table tr { border-bottom: 1px solid var(--line); }
    .vs-table tr:last-child { border-bottom: none; }
    .rel-list, .case-list { list-style: none; padding: 0; display: grid; gap: 8px; }
    .rel-item { padding: 10px 14px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .rel-item.past { opacity: 0.65; }
    .rel-type {
      font-size: 0.72rem; font-weight: 700; color: var(--accent);
      background: var(--accent-soft); border-radius: 6px; padding: 2px 8px; flex-shrink: 0;
    }
    .rel-when { font-size: 0.76rem; }
    .case-link { display: block; padding: 10px 14px; text-decoration: none; }
    .case-link:hover { border-color: var(--accent); }
  </style>
</Base>
