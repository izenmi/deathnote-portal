---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import characters from '../data/characters.json';

const base = import.meta.env.BASE_URL;
const pickup = ['light', 'l', 'ryuk', 'misa', 'near', 'mello']
  .map((id) => characters.characters.find((c) => c.id === id)!)
  .filter(Boolean);

const sections = [
  { href: `${base}characters/`, icon: '🗂', title: '人物ファイル', desc: '捜査本部から死神まで、事件関係者の名簿と公式プロフィール' },
  { href: `${base}rules/`, icon: '📓', title: 'ノートのルール', desc: '読み進めた分だけ判明していく、デスノートの使用条件' },
  { href: `${base}cases/`, icon: '🔍', title: '事件の記録', desc: 'キラとLの攻防を、事件ごとに段階を追って記録' },
  { href: `${base}timeline/`, icon: '📜', title: '統合年表', desc: '2003年11月28日から始まる事件の全体像' },
  { href: `${base}notebooks/`, icon: '📕', title: 'ノート所有権の変遷', desc: '人間界に存在するノートが誰の手にあったのか' },
  { href: `${base}relations/`, icon: '🕸️', title: '人物相関図', desc: '読了位置に応じて関係線が変化する相関図' },
  { href: `${base}profiles/`, icon: '📇', title: 'プロフィール一覧', desc: '生年月日・身長・血液型を並べ替えて比較' },
  { href: `${base}versus/`, icon: '⚔️', title: 'VS比較', desc: '2人のプロフィールと関わった事件を並べて比較' },
  { href: `${base}birthdays/`, icon: '🎂', title: '誕生日カレンダー', desc: '公式設定の誕生日を月別カレンダーで' },
  { href: `${base}stats/`, icon: '📈', title: '勢力の推移', desc: 'キラと捜査側の優勢がどう入れ替わったかをグラフで' },
  { href: `${base}media/`, icon: '📺', title: 'メディア展開', desc: 'アニメ全37話・実写映画・ドラマ・小説の一覧' },
  { href: `${base}quiz/`, icon: '✏️', title: '原作知識クイズ', desc: '難易度3段階×10問であなたの読み込み度を測定' },
  { href: `${base}shindan/`, icon: '🧭', title: 'ノートを拾ったら診断', desc: 'あなたがノートを手にしたらどう動くか' },
  { href: `${base}taiken/`, icon: '🎭', title: '事件を体験', desc: '選択を重ねて事件の一場面を追体験するADV' },
  { href: `${base}sousa/`, icon: '🧠', title: '捜査能力テスト', desc: 'ミニゲームで捜査適性を実測し、成績カードを発行' },
];
const bdayList = characters.characters
  .filter((c: any) => c.birthday)
  .map((c: any) => ({ b: c.birthday, n: c.name, sp: c.sp }));
---

<Base>
  <section class="hero card">
    <p class="hero-tag">THE KIRA CASE ARCHIVE</p>
    <h1>キラ事件ポータル<br />捜査資料室</h1>
    <p class="hero-lead">
      2003年11月28日。一冊のノートが人間界に落ちた日から、名前を書かれた者が次々に死ぬ連続殺人——「キラ事件」が始まった。
      ここは『DEATH NOTE』の物語を、人物ファイル・事件の記録・ノートのルールから辿る非公式ファンサイトです。
    </p>
    <p class="hero-note">
      📖 右上のボタンで<strong>読了位置</strong>を設定すると、それより先のネタバレは自動で隠されます。未読の方も安心してご利用ください。
    </p>
  </section>

  <section>
    <h2 class="section-title">メニュー</h2>
    <div class="grid menu-grid">
      {sections.map((s) => (
        <a href={s.href} class="card menu-card">
          <span class="menu-icon">{s.icon}</span>
          <strong>{s.title}</strong>
          <p class="muted">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <div id="home-bday" class="card home-bday" hidden>
    🎂 <strong>今日が誕生日:</strong> <span id="home-bday-names"></span>
    <a href={`${base}birthdays/`} class="muted" style="font-size: 0.8rem;">カレンダーを見る →</a>
  </div>

  <script is:inline define:vars={{ bdayList }}>
    const renderBday = () => {
      const now = new Date();
      const key = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
      const progress = window.KIRA ? window.KIRA.progress : 0;
      const hits = bdayList.filter((x) => x.b === key && x.sp <= Math.max(progress, 1));
      const box = document.getElementById('home-bday');
      if (hits.length === 0) { box.hidden = true; return; }
      document.getElementById('home-bday-names').textContent = hits.map((x) => x.n).join('、');
      box.hidden = false;
    };
    document.addEventListener('kira:progress', renderBday);
    window.addEventListener('DOMContentLoaded', renderBday);
  </script>

  <section>
    <h2 class="section-title">事件の中心人物</h2>
    <div data-sp-count>
      <p class="sp-note"></p>
      <div class="pickup-row">
        {pickup.map((c) => (
        <a
          href={`${base}characters/${c.id}/`}
          class="pickup-card card"
          data-sp={c.sp > 1 ? c.sp : undefined}
          data-sp-hide={c.sp > 1 ? '' : undefined}
        >
            <Portrait id={c.portrait ? c.id : `sil-${c.id}`} size={84} sideKey={c.side} />
            <strong>{c.name}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .hero { padding: 30px 26px; border-top: 4px solid var(--accent); }
    .hero-tag { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--ink-2); margin: 0; }
    .hero h1 { font-size: 1.9rem; line-height: 1.3; margin: 8px 0 12px; }
    .hero-lead { max-width: 46em; }
    .hero-note {
      background: var(--surface-2); border-radius: 10px; padding: 10px 14px;
      font-size: 0.88rem; margin-bottom: 0;
    }
    .menu-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    .menu-card { padding: 16px; text-decoration: none; }
    .menu-card:hover { border-color: var(--accent); }
    .menu-icon { font-size: 1.5rem; }
    .menu-card strong { display: block; margin: 6px 0 2px; }
    .menu-card p { font-size: 0.8rem; margin: 0; }
    .pickup-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .pickup-card {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 14px 18px; text-decoration: none; font-size: 0.88rem;
    }
    .pickup-card:hover { border-color: var(--accent); }
    .home-bday { padding: 10px 16px; margin-top: 14px; font-size: 0.92rem; border-left: 4px solid var(--accent); }
  </style>
</Base>
