---
import Base from '../../layouts/Base.astro';
import cases from '../../data/cases.json';

const base = import.meta.env.BASE_URL;
const arcs = ['第一部', '第二部'];
const WINNER: Record<string, { label: string; side: string }> = {
  kira: { label: 'キラ優勢', side: 'kira' },
  l: { label: '捜査側優勢', side: 'l' },
  draw: { label: '決着つかず', side: 'other' },
};
---

<Base title="事件の記録" description="キラ事件の各局面を、状況・結末・使われたノートのルールとともに記録。ネタバレは読了位置に応じて自動で隠されます。">
  <h1>🔍 事件の記録</h1>
  <p class="muted">
    キラとLの攻防を局面ごとに整理しています。読了位置(右上📖)より先の事件は内容を伏せています。
    各ページでは「表向きの結末」と「後から判明する裏側」を段階的に開示します。
  </p>

  {arcs.map((arc) => (
    <section>
      <h2 class="section-title">{arc}</h2>
      <div class="timeline" data-sp-count>
        <p class="sp-note"></p>
        {cases.filter((e) => e.arc === arc).map((e) => (
          <div class="timeline-item" data-sp={e.sp > 1 ? e.sp : undefined}>
            <div class="timeline-marker">
              <span class="vol-badge">{e.vol}巻</span>
            </div>
            <a href={`${base}cases/${e.id}/`} class="card case-card">
              <div class="case-head">
                <strong>{e.name}</strong>
                <span class="type-tag">{e.type}</span>
                <span class="side-chip" data-side={WINNER[e.winner].side}>{WINNER[e.winner].label}</span>
              </div>
              <p class="muted case-date">{e.date}</p>
              <p class="case-setup">{e.setup.length > 90 ? e.setup.slice(0, 90) + '…' : e.setup}</p>
            </a>
          </div>
        ))}
      </div>
    </section>
  ))}

  <style>
    .timeline { position: relative; padding-left: 4px; }
    .timeline-item {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 12px;
      margin-bottom: 14px;
    }
    .timeline-marker { position: relative; text-align: center; padding-top: 12px; }
    .timeline-marker::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: -14px;
      width: 2px;
      background: var(--line);
      z-index: 0;
    }
    .timeline-item:last-child .timeline-marker::before { bottom: auto; height: 100%; }
    .vol-badge {
      position: relative; z-index: 1;
      display: inline-block;
      background: var(--noir); color: var(--noir-ink);
      font-size: 0.72rem; font-weight: 700;
      border-radius: 999px; padding: 3px 8px;
    }
    .case-card { display: block; padding: 14px 16px; text-decoration: none; }
    .case-card:hover { border-color: var(--accent); }
    .case-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .case-head strong { font-size: 1.02rem; }
    .type-tag {
      font-size: 0.72rem; font-weight: 700;
      background: var(--accent-soft); color: var(--accent);
      border-radius: 6px; padding: 2px 8px;
    }
    .case-date { font-size: 0.8rem; margin: 4px 0; }
    .case-setup { font-size: 0.88rem; margin: 0; color: var(--ink-2); }
  </style>
</Base>
